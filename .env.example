# OpenAI-compatible embedding endpoint. Copy this file to .env and fill all values.
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

# Local pgvector instance managed by compose.yaml.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=dba
DB_USER=dba
DB_PASSWORD=

# OpenAI-compatible model used to plan and synthesize research runs.
# DeepSeek example: model=deepseek-chat, base_url=https://api.deepseek.com
RESEARCH_MODEL=deepseek-chat
RESEARCH_BASE_URL=https://api.deepseek.com
RESEARCH_API_KEY=
RESEARCH_MAX_QUERIES=4
RESEARCH_EVIDENCE_LIMIT=10

# LangGraph agent budgets. MAX_QUERIES/EVIDENCE_LIMIT above are legacy workflow settings.
RESEARCH_MAX_STEPS=12
RETRIEVAL_DEFAULT_TOP_K=8
RESEARCH_MAX_EVIDENCE_READS=12
RESEARCH_MAX_WORKERS=4
RESEARCH_MAX_SUBTASKS=8

# Optional Langfuse tracing.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
