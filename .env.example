# OpenAI-compatible embedding endpoint. Copy this file to .env and fill all values.
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

# Local pgvector instance managed by compose.yaml.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=dba
DB_USER=dba
DB_PASSWORD=
