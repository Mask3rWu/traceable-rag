# OpenAI-compatible embedding endpoint. Copy this file to .env and fill all values.
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32

# Local pgvector instance managed by compose.yaml.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=dba
DB_USER=dba
DB_PASSWORD=

# OpenAI-compatible model used to plan and synthesize research runs.
# DeepSeek example: model=deepseek-chat, base_url=https://api.deepseek.com
RESEARCH_MODEL=deepseek-chat
RESEARCH_BASE_URL=https://api.deepseek.com
RESEARCH_API_KEY=
RESEARCH_MAX_QUERIES=4
RESEARCH_EVIDENCE_LIMIT=10

# LangGraph agent budgets. MAX_QUERIES/EVIDENCE_LIMIT above are legacy workflow settings.
RESEARCH_MAX_STEPS=12
RESEARCH_FAST_MAX_STEPS=8
RESEARCH_WORKER_MAX_STEPS=30
RESEARCH_SUPERVISOR_MAX_STEPS=12
RETRIEVAL_DEFAULT_TOP_K=8
RESEARCH_MAX_EVIDENCE_READS=40
RESEARCH_MAX_WORKERS=4
RESEARCH_MAX_SUBTASKS=8
RESEARCH_DOCUMENT_MAX_CHARS=6000
RESEARCH_CHAPTER_MAX_CHARS=1600
RESEARCH_CHAPTER_MAX_RULES=20
RESEARCH_MAX_SEARCH_PER_WORKER=5

# Thinking/预算旋钮（按 agent 角色分设，均 opt-in）：
# - 关思考：防止 reasoning token 独吞 completion 预算而挂起 tool_calls。
# - token 上限：硬限 completion token（走 extra_body.max_tokens；deepseek 只认
#   max_tokens，langchain 会把 ChatOpenAI.max_tokens 改写成 max_completion_tokens，
#   deepseek 忽略，故必须由 LLM 工厂的 token_budget 生效）。设正整数才真正限 token，
#   留空=不限（None）。每个 agent 角色独立：fast=router+fast agent、planner=章节规划、
#   worker=章节 worker、reviewer=就地整章一致性修复（可到 ~30K，须留量）。
#   thinking 开启时 reasoning 无上界，请勿在上限设紧的同时开思考（会中途截断）；
#   真正止血是默认关思考 + 各角色的内容预算。思考开关默认关闭：
#   RESEARCH_THINKING_<ROLE>=false 即关思考（默认）；置 true 开思考（不发送 thinking
#   字段，交由上游默认）。
#   下列默认值为按真实内容占用估算的起点（待 probe 校准）：fast=8192 / planner=2048 /
#   worker=8192 / reviewer=32768。保持值即启用预算；清空以回到不限。
RESEARCH_THINKING_FAST=false
RESEARCH_THINKING_PLANNER=false
RESEARCH_THINKING_WORKER=false
RESEARCH_THINKING_REVIEWER=false
RESEARCH_FAST_TOKEN_BUDGET=8192
RESEARCH_PLANNER_TOKEN_BUDGET=2048
RESEARCH_WORKER_TOKEN_BUDGET=8192
RESEARCH_REVIEWER_TOKEN_BUDGET=32768

# Optional Langfuse tracing.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Concurrent top-level API runs. Each run creates an isolated agent runtime.
API_MAX_CONCURRENT_RUNS=2
